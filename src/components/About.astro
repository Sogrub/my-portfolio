---
interface Props {
  t: {
    title: string;
    fullstack: string;
    developer: string;
    mainCard: string;
    communication: string;
    remoteReady: string;
    learning: string;
    techStack: string;
    passion: string;
    automation: string;
    aiTools: string;
    startProject: string;
    copyEmail: string;
    codeComment: string;
  };
}

const { t } = Astro.props;

const techStack = [
  "JavaScript",
  "TypeScript",
  "Angular",
  "React",
  "Next.js",
  "Node.js",
  "NestJS",
  "Express",
  "PostgreSQL",
  "MongoDB",
  "AWS",
  "Docker",
];

const codeLines = [
  { num: 1, content: `<span class="comment">${t.codeComment}</span>` },
  { num: 2, content: '<span class="function">console</span>.<span class="function">log</span>(<span class="string">`</span>' },
  { num: 3, content: '<span class="string">╔═╗╔═╗╔═╗╦═╗╦ ╦╔═╗</span>' },
  { num: 4, content: '<span class="string">╚═╗║ ║║ ╦╠╦╝║ ║╠═║</span>' },
  { num: 5, content: '<span class="string">╚═╝╚═╝╚═╝╩╚═╚═╝╚═╝</span>' },
  { num: 6, content: '<span class="string">`</span>);' },
];
---

<section id="about" class="flex flex-col pt-36 font-bold gap-8 text-white">
  <h2 class="text-4xl text-center">{t.title}</h2>
  <div class="bento-grid">
    <div class="card card-main">
      <div class="floating-elements">
        <span class="bubble bubble-purple">{t.fullstack}</span>
        <span class="bubble bubble-dark">{t.developer}</span>
      </div>
      <div class="laptop-mockup">
        <div class="laptop-screen">
          <div class="screen-content">
            <span>&lt;/&gt;</span>
          </div>
        </div>
      </div>
      <h2>{t.mainCard}</h2>
      <div class="highlight-bar"></div>
    </div>

    <div class="card card-flexible">
      <h3>{t.communication}</h3>
      <div class="globe"></div>
      <span class="badge">{t.remoteReady}</span>
    </div>

    <div class="card card-stack">
      <span class="label">{t.learning}</span>
      <h3>{t.techStack}</h3>
      <div class="stack-grid">
        {techStack.map((item) => <div class="stack-item">{item}</div>)}
      </div>
    </div>

    <div class="card card-passion">
      <h3>{t.passion}</h3>
      <div class="progress-bars">
        <div class="progress"><div class="fill fill-1"></div></div>
        <div class="progress"><div class="fill fill-2"></div></div>
      </div>
    </div>

    <div class="card card-ai">
      <span class="section-label">{t.automation}</span>
      <h3>{t.aiTools}</h3>
      <div class="ai-icons">
        <div class="ai-icon">🤖</div>
        <div class="ai-icon">⚡</div>
        <div class="ai-icon">🔗</div>
      </div>
    </div>

    <div class="card card-contact">
      <h3>{t.startProject}</h3>
      <button
        class="contact-btn"
        onclick="navigator.clipboard.writeText('diegoaburgos1@gmail.com')"
      >
        <svg
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <rect x="9" y="9" width="13" height="13" rx="2"></rect>
          <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"
          ></path>
        </svg>
        {t.copyEmail}
      </button>
    </div>

    <div class="card card-code">
      <div class="code-header">
        <span class="dot red"></span>
        <span class="dot yellow"></span>
        <span class="dot green"></span>
      </div>
      <div class="code-content">
        {
          codeLines.map((line) => (
            <div class="code-line">
              <span class="line-num">{line.num}</span>
              <span class="code-text" set:html={line.content} />
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  section {
    --bg-card: #04071d;
    --bg-card-hover: #0a0e24;
    --border: #6971a2;
    --accent: #cbacf9;
    --accent-cyan: #4facfe;
    --accent-yellow: #fbbf24;
    --text-muted: #9ca3af;
  }

  .bento-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-template-rows: repeat(4, minmax(180px, auto));
    gap: 1.25rem;
  }

  .card {
    background: var(--bg-card);
    border-radius: 20px;
    padding: 1.75rem;
    border: 1px solid var(--border);
    position: relative;
    overflow: hidden;
    transition: all 0.3s ease;
  }

  .card:hover {
    transform: translateY(-4px);
    background: var(--bg-card-hover);
    border-color: rgba(203, 172, 249, 0.4);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4);
  }

  .card-main {
    grid-column: span 2;
    grid-row: span 2;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    background: linear-gradient(135deg, var(--bg-card) 0%, #1a1025 100%);
  }

  .floating-elements {
    display: flex;
    gap: 0.5rem;
  }

  .bubble {
    padding: 0.5rem 1rem;
    border-radius: 20px;
    font-size: 0.75rem;
    animation: float 3s ease-in-out infinite;
  }

  .bubble-purple {
    background: var(--accent);
    color: #0c0f24;
  }
  .bubble-dark {
    background: #2d2d3a;
    color: var(--text-muted);
    animation-delay: 0.5s;
  }

  @keyframes float {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-8px);
    }
  }

  .laptop-mockup {
    width: 100%;
    max-width: 320px;
    margin: 2rem auto 1.5rem;
    perspective: 1000px;
  }

  .laptop-screen {
    background: linear-gradient(135deg, #1e1e2e 0%, #0d1117 100%);
    border-radius: 12px;
    padding: 1rem;
    border: 2px solid #333;
    transform: rotateX(5deg);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.5);
  }

  .screen-content {
    background: linear-gradient(180deg, #000428 0%, #004e92 100%);
    border-radius: 8px;
    height: 140px;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    overflow: hidden;
  }

  .screen-content::before {
    content: "";
    position: absolute;
    width: 80px;
    height: 80px;
    background: radial-gradient(circle, #4facfe 0%, transparent 70%);
    border-radius: 50%;
    animation: pulse 2s ease-in-out infinite;
  }

  .screen-content span {
    font-size: 1.5rem;
    font-weight: 700;
    color: white;
    text-shadow: 0 0 20px rgba(79, 172, 254, 0.8);
    z-index: 1;
  }

  .card-main h2 {
    font-size: 1.5rem;
    font-weight: 600;
    line-height: 1.3;
  }

  .highlight-bar {
    width: 60px;
    height: 6px;
    background: var(--accent-yellow);
    border-radius: 3px;
    margin-top: 1rem;
  }

  .card-flexible {
    grid-column: span 2;
    background: linear-gradient(135deg, var(--bg-card) 0%, #1a1520 100%);
  }

  .card-flexible h3 {
    font-size: 1.3rem;
    font-weight: 600;
    line-height: 1.3;
  }

  .globe {
    position: absolute;
    right: -20px;
    bottom: -20px;
    width: 150px;
    height: 150px;
    background:
      radial-gradient(
        circle at 30% 30%,
        var(--accent-cyan) 0%,
        transparent 50%
      ),
      radial-gradient(circle at 70% 70%, var(--accent) 0%, transparent 50%);
    border-radius: 50%;
    opacity: 0.5;
    filter: blur(20px);
  }

  .badge {
    position: absolute;
    bottom: 1.5rem;
    right: 1.5rem;
    background: rgba(203, 172, 249, 0.15);
    padding: 0.5rem 1rem;
    border-radius: 20px;
    font-size: 0.8rem;
    color: var(--accent);
    border: 1px solid rgba(203, 172, 249, 0.3);
  }

  .card-stack {
    grid-column: span 2;
    grid-row: span 2;
  }

  .card-stack .label {
    font-size: 0.85rem;
    color: var(--text-muted);
    display: block;
    margin-bottom: 0.5rem;
  }

  .card-stack h3 {
    font-size: 1.4rem;
    font-weight: 600;
    margin-bottom: 1.5rem;
  }

  .stack-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.75rem;
  }

  .stack-item {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--border);
    padding: 0.75rem 1rem;
    border-radius: 10px;
    font-size: 0.85rem;
    color: var(--text-muted);
    transition: all 0.3s ease;
  }

  .stack-item:hover {
    background: rgba(203, 172, 249, 0.1);
    border-color: rgba(203, 172, 249, 0.4);
    color: white;
    transform: translateX(4px);
  }

  .card-passion {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .card-passion h3 {
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.4;
  }

  .progress-bars {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-top: 1rem;
  }

  .progress {
    height: 8px;
    background: rgba(255, 255, 255, 0.1);
    border-radius: 4px;
    overflow: hidden;
  }

  .fill {
    height: 100%;
    border-radius: 4px;
    animation: fillBar 2s ease-out forwards;
  }

  .fill-1 {
    width: 90%;
    background: var(--accent);
  }
  .fill-2 {
    width: 75%;
    background: var(--accent-cyan);
    animation-delay: 0.3s;
  }

  @keyframes fillBar {
    from {
      transform: translateX(-100%);
    }
    to {
      transform: translateX(0);
    }
  }

  .card-ai {
    background: linear-gradient(135deg, #1a1025 0%, var(--bg-card) 100%);
  }

  .card-ai .section-label {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: var(--accent-yellow);
    display: block;
    margin-bottom: 0.5rem;
  }

  .card-ai h3 {
    font-size: 1.2rem;
    font-weight: 600;
    line-height: 1.3;
  }

  .ai-icons {
    display: flex;
    gap: 0.5rem;
    margin-top: 1rem;
  }

  .ai-icon {
    width: 36px;
    height: 36px;
    background: rgba(251, 191, 36, 0.1);
    border: 1px solid rgba(251, 191, 36, 0.3);
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .card-contact h3 {
    font-size: 1.1rem;
    font-weight: 600;
    margin-bottom: 1rem;
  }

  .contact-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(203, 172, 249, 0.15);
    border: 1px solid rgba(203, 172, 249, 0.4);
    padding: 0.6rem 1rem;
    border-radius: 8px;
    color: white;
    font-size: 0.8rem;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .contact-btn:hover {
    background: var(--accent);
    color: #0c0f24;
  }

  .card-code {
    grid-column: span 2;
    font-family: "JetBrains Mono", "Fira Code", monospace;
    background: #0d1117;
    padding: 0;
  }

  .code-header {
    display: flex;
    gap: 6px;
    padding: 1rem 1.5rem;
    background: rgba(255, 255, 255, 0.03);
    border-bottom: 1px solid var(--border);
  }

  .dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
  }

  .dot.red {
    background: #ff5f56;
  }
  .dot.yellow {
    background: #ffbd2e;
  }
  .dot.green {
    background: #27ca40;
  }

  .code-content {
    padding: 1.25rem 1.5rem;
    font-size: 0.8rem;
    line-height: 1.8;
  }

  .code-line {
    display: flex;
  }

  .line-num {
    color: #6e7681;
    width: 30px;
    flex-shrink: 0;
  }

  .code-text {
    color: #e6edf3;
  }
  .code-text :global(.keyword) {
    color: #ff7b72;
  }
  .code-text :global(.string) {
    color: #a5d6ff;
  }
  .code-text :global(.comment) {
    color: #8b949e;
  }
  .code-text :global(.variable) {
    color: #ffa657;
  }
  .code-text :global(.function) {
    color: #d2a8ff;
  }

  @media (max-width: 1024px) {
    .bento-grid {
      grid-template-columns: repeat(2, 1fr);
      grid-template-rows: auto;
    }

    .card-main,
    .card-flexible,
    .card-stack,
    .card-code {
      grid-column: span 2;
    }

    .card-stack {
      grid-row: span 1;
    }
  }

  @media (max-width: 640px) {
    .bento-grid {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .card-main,
    .card-flexible,
    .card-stack,
    .card-code {
      grid-column: span 1;
    }

    .stack-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
